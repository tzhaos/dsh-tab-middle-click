{
  "name": "dsh-tab-middle-click",
  "version": "1.0.0",
  "private": true,
  "description": "Close DSH sidebar/dock tabs with a middle-click, using the tab's existing close control.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "tabs",
    "middle-click",
    "sidebar",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzhaos/dsh-tab-middle-click.git"
  },
  "homepage": "https://github.com/tzhaos/dsh-tab-middle-click#readme",
  "bugs": {
    "url": "https://github.com/tzhaos/dsh-tab-middle-click/issues"
  }
}
